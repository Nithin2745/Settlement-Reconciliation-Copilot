# Copy this file to .env and fill in your own values. Never commit .env itself.

# "live"    -> calls the real Razorpay Settlement Recon API (needs the two keys below)
# "fixture" -> reads a captured/sample response from FIXTURE_PATH, no network call, no keys needed
SETTLEMENT_SOURCE_MODE=fixture

# Test-mode keys from https://dashboard.razorpay.com/app/keys (use TEST mode, not live mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Which day to pull settlement recon data for (used in both live and capture modes)
SETTLEMENT_YEAR=2026
SETTLEMENT_MONTH=9
SETTLEMENT_DAY=1

# Used only in fixture mode. Point this at a real captured response once you have one
# (scripts/captureFixture.js writes to fixtures/settlement-recon-captured.json).
FIXTURE_PATH=fixtures/settlement-recon-sample.json

# ---------------------------------------------------------------------------
# Day 3 — LLM exception layer (ADR-003: Groq primary, OpenRouter fallback)
# ---------------------------------------------------------------------------
# Two providers on purpose. The fallback is not redundancy theatre: deliberately
# breaking GROQ_API_KEY and watching the OpenRouter path take over is the
# Failure Recovery demo, so both must be independently valid.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# The ":free" suffix is part of the model id, not a flag.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ---------------------------------------------------------------------------
# LLM tuning knobs. Every one of these is optional — src/config.js has a
# default for all of them. They are listed here so the full set of things the
# app reads from the environment is visible in one place, and so an ablation
# ("what happens at threshold 0?") is a one-line edit rather than a code change.
# All are parsed by numberFromEnv(): unset falls back to the default, but
# set-but-unparseable or out-of-range throws at startup instead of silently
# reverting to the default.
# ---------------------------------------------------------------------------
# Below this confidence, a structurally valid decision is flagged for a human
# instead of auto-accepted (validateDecision.js). Range 0–1.
LLM_CONFIDENCE_THRESHOLD=0.7

# Max shortlisted bank/ledger candidates shown per exception. Bounds prompt
# size and keeps the hallucination gate's "real id" set small and auditable.
LLM_MAX_CANDIDATES=5

# Per-request network timeout, milliseconds.
LLM_TIMEOUT_MS=30000

# Both configured models are REASONING models: they emit a chain of thought
# before the answer, and it is billed against this same budget. At 500 the
# reasoning alone exhausted it and no JSON was ever produced — Groq returned
# HTTP 400 json_validate_failed with an empty generation, OpenRouter returned
# raw prose. Do not lower this below ~1500.
LLM_MAX_TOKENS=2500

# Retries against the SAME provider before failing over, and only for transient
# failures (timeout / 429 / 5xx). A 400 is never retried — the request itself is
# wrong, so a retry fails identically and just burns quota.
LLM_ATTEMPTS_PER_PROVIDER=2

# After this many consecutive primary failures in one batch, skip the primary
# entirely and go straight to the fallback. Without it, a hard-down Groq costs
# one doomed round-trip per record before every single fallback call.
LLM_PRIMARY_FAILURE_THRESHOLD=3
